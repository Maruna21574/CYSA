APP_NAME=CYSA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://cysa.test

APP_LOCALE=sk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sk_SK

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cysa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@cysa.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- CYSA ---------------------------------------------------------------
APP_TIMEZONE=Europe/Bratislava
# Private study materials: "materials" (local, storage/app/private/materials) or "s3".
MATERIALS_DISK=materials
MATERIALS_MAX_UPLOAD_KB=51200
# Content Security Policy - enabled automatically when APP_ENV=production.
# CSP_ENABLED=true

# --- Production (Websupport) - see docs/DEPLOYMENT.md -------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://www.vasadomena.sk
# LOG_LEVEL=warning
# SESSION_SECURE_COOKIE=true
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.m1.websupport.sk
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=noreply@vasadomena.sk
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=noreply@vasadomena.sk
